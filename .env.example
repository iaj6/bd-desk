# Anthropic API key (console.anthropic.com → API Keys). The `ant` CLI login also works.
ANTHROPIC_API_KEY=sk-ant-...

# Your deployed CRM's public base url (after you deploy crm/ to Vercel).
CRM_URL=https://your-crm.vercel.app

# CRM ingest bearer — the same value as the CRM's INGEST_TOKEN env var.
# Used by `npm run brand-pack` to push the compiled canon to the CRM.
CRM_INGEST_TOKEN=

# Weekly digest email delivery (used at prompt-push time by setup-digest / update).
DIGEST_TO=you@example.com
EMAIL_FROM=BD Desk <onboarding@resend.dev>

# Resend API key — added to the vault by `npm run deploy-digest` so the digest
# agent can send email without ever seeing the key.
RESEND_API_KEY=

# CRM MCP bearer — the same value as the CRM's MCP_TOKEN env var. Added to the
# vault by `npm run setup-mcp` so agents can call the CRM's MCP tools.
MCP_TOKEN=

# Optional: where brand-pack.yaml lives, if you keep your canon outside the repo
# (default: ./brand). Handy for keeping positioning in a private directory.
# BRAND_DIR=/path/to/private/brand
