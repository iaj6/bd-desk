# Vercel Blob storage (auto-provisioned when you add Blob to the Vercel project).
BLOB_READ_WRITE_TOKEN=

# Anthropic API key — used server-side to start research sessions + draft outreach.
ANTHROPIC_API_KEY=sk-ant-...

# Managed Agents ids (from .managed-agents.json after running the setup scripts).
DOSSIER_AGENT_ID=
SPONSOR_AGENT_ID=
ENVIRONMENT_ID=

# Auth doors (mint long random strings for each):
INGEST_TOKEN=      # agents + brand-pack push (bearer on /api/targets, /api/brand-pack)
MCP_TOKEN=         # MCP clients (bearer on /api/mcp)
CRON_SECRET=       # Vercel Cron (bearer on /api/cron/*)
CRM_PASSWORD=      # HTTP Basic Auth for the UI (any username)

# Morning brief email (optional — brief is skipped if unset).
RESEND_API_KEY=
BRIEF_EMAIL=you@example.com
EMAIL_FROM=BD Desk <onboarding@resend.dev>
CRM_PUBLIC_URL=https://your-crm.vercel.app
