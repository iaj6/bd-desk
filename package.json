    "setup-sponsor": "tsx src/setup-sponsor.ts",
    "setup-radar": "tsx src/setup-radar.ts",
    "setup-digest": "tsx src/setup-digest.ts",
    "setup-vault": "tsx src/setup-vault.ts",
    "setup-mcp": "tsx src/setup-mcp.ts",
    "setup-skills": "tsx src/setup-skills.ts",
    "setup-multiagent": "tsx src/setup-multiagent.ts",
    "update": "tsx src/update.ts",
    "dossier": "tsx src/dossier.ts",
    "radar": "tsx src/radar.ts",
    "deploy-radar": "tsx src/deploy-radar.ts",
    "radar-fire": "tsx src/radar-fire.ts",
    "radar-runs": "tsx src/radar-runs.ts",
